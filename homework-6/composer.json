{
    "name": "homework/banking-pipeline",
    "description": "Banking transaction-processing pipeline: validate, fraud-score, settle",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "brick/math": "^0.12",
        "mcp/sdk": "^0.6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "BankingPipeline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BankingPipeline\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "coverage": "php -d pcov.enabled=1 vendor/bin/phpunit --coverage-text --coverage-clover coverage.xml"
    }
}
