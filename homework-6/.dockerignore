# .dockerignore — exclude files that should not be sent to the Docker build context
#
# Keeping the build context lean speeds up `make build` and avoids accidentally
# baking runtime state or large directories into the image.

# Composer dependencies (installed inside the container via `make install`)
vendor/

# Runtime message queues (bind-mounted at runtime, not baked into the image)
shared/

# Documentation assets
docs/

# Version control
.git/
.gitignore

# IDE and editor metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Coverage and test artefacts
coverage.xml
.phpunit.result.cache

# Claude/agent configuration (not needed in the image)
.claude/
context/

# Node artefacts (none expected, but guard against accidental inclusion)
node_modules/
