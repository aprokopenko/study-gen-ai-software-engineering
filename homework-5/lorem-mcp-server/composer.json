{
    "name": "homework/lorem-mcp-server",
    "description": "Custom MCP server exposing lorem-ipsum text as a Resource and Tool",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "mcp/sdk": "*",
        "symfony/finder": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    }
}
