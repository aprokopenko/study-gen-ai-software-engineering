{
    "name": "homework/support-system",
    "type": "project",
    "require": {
        "php": "^8.5",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "catfan/medoo": "^2.2",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
